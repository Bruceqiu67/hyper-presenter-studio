{
  "project": "HyperPresenter Studio",
  "theme": "prismatic-aurora",
  "name": "Prismatic Aurora (极光五彩绚烂风)",
  "resolution": {
    "width": 1080,
    "height": 1920,
    "ratio": "9:16"
  },
  "colors": {
    "primary": "#38bdf8",
    "secondary": "#f472b6",
    "accent": "#fbbf24",
    "window_background": "rgba(20, 14, 38, 0.84)",
    "window_border": "rgba(244, 114, 182, 0.38)",
    "text_main": "#ffffff",
    "text_dim": "#a5b4fc",
    "tag_background": "linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(244, 114, 182, 0.2))",
    "tag_border": "rgba(244, 114, 182, 0.5)"
  },
  "typography": {
    "font_family_code": "JetBrains Mono, Consolas, monospace",
    "font_family_heading": "Outfit, -apple-system, sans-serif",
    "font_size_terminal": "18px"
  },
  "layout": {
    "terminal_width": 920,
    "terminal_height": 1100,
    "border_radius": 20
  }
}