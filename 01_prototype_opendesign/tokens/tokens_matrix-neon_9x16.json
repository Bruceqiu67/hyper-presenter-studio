{
  "project": "HyperPresenter Studio",
  "theme": "matrix-neon",
  "name": "Matrix Neon (极客骇客绿)",
  "resolution": {
    "width": 1080,
    "height": 1920,
    "ratio": "9:16"
  },
  "colors": {
    "primary": "#10b981",
    "secondary": "#34d399",
    "accent": "#a7f3d0",
    "window_background": "rgba(8, 26, 17, 0.82)",
    "window_border": "rgba(16, 185, 129, 0.25)",
    "text_main": "#ecfdf5",
