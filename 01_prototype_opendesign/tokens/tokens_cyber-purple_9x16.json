{
  "project": "Reasonix CLI",
  "theme": "cyber-purple",
  "name": "Cyber Purple (赛博霓虹紫)",
  "resolution": {
    "width": 1080,
    "height": 1920,
    "ratio": "9:16"
  },
  "colors": {
    "primary": "#c084fc",
    "secondary": "#f472b6",
    "accent": "#38bdf8",
    "window_background": "rgba(23, 14, 43, 0.8)",
    "window_border": "rgba(192, 132, 252, 0.25)",
    "text_main": "#faf5ff",
    "text_dim": "#7e6c9e",
